{
  "manifest_version": 3,
  "name": "豆豆 - 日常工具箱",
  "version": "3.0.1",
  "description": "",
  "permissions": [
    "storage",
    "scripting",
    "cookies",
    "debugger",
    "downloads",
    "clipboardRead",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": {
      "16": "icons/doudou_16.png",
      "48": "icons/doudou_48.png",
      "128": "icons/doudou_128.png"
    },
    "default_title": "doudou",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/floating-btn.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/doudou_16.png",
    "48": "icons/doudou_48.png",
    "128": "icons/doudou_128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src * data: blob: filesystem:;"
  }
}
